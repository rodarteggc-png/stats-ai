# Telegram Bot Config
TELEGRAM_BOT_TOKEN=tu_telegram_bot_token_aqui
TELEGRAM_CHAT_ID=tu_telegram_chat_id_aqui
TELEGRAM_VIP_CHAT_ID=tu_chat_id_privado_admin
# Secreto registrado con setWebhook(secret_token=...) — Telegram lo envía en cada update
TELEGRAM_WEBHOOK_SECRET=genera_un_valor_aleatorio_de_32+_caracteres
# Canal privado append-only para el ledger inmutable (en Vercel el disco es de solo lectura)
TELEGRAM_LEDGER_CHAT_ID=id_del_canal_privado_ledger

# Autenticación de /api/scan, /api/audit, /api/quota (header Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=genera_un_valor_aleatorio_de_32+_caracteres

# Proveedores de datos (NUNCA en el código fuente)
ODDS_API_KEYS=llave1,llave2
APISPORTS_KEY=tu_llave_api_sports
GEMINI_API_KEY=tu_llave_gemini

# Token que el portal web envía a /api/gemini (header x-portal-token)
PORTAL_ACCESS_TOKEN=genera_un_valor_aleatorio_de_32+_caracteres
